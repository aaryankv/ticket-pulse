DATABASE_URL="postgresql://ticket_pulse:ticket_pulse@postgres:5432/ticket_pulse?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_SECRET="replace-with-a-strong-random-secret"

# Optional Oracle SSO / OIDC provider for app login.
# Leave blank for local email/password auth during development.
ORACLE_SSO_ISSUER=""
ORACLE_SSO_CLIENT_ID=""
ORACLE_SSO_CLIENT_SECRET=""

# SSO-protected enterprise portals used for deep links.
SUPPORT_ORACLE_PORTAL_URL="https://support.oracle.com/support/?page=sptemplate&sptemplate=service-request"
JIRA_ORACLE_PORTAL_URL="https://jira.oraclecorp.com/"
BUG_ORACLE_PORTAL_URL="https://bug.oraclecorp.com/ords/bug/bugui/home"

APP_BASE_URL="http://localhost:3000"
APP_ENV="development"
DEMO_MODE="false"
ENTERPRISE_FETCH_MODE="auto"

EXTERNAL_TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

POLLING_INTERVAL_MINUTES="30"
REDIS_URL="redis://redis:6379"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Ticket Pulse <ticket-pulse@example.com>"

SLACK_DEFAULT_WEBHOOK_URL=""
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="120"


# Local RPA browser tracker. Run npm run browser:connect once to complete Oracle SSO.
BROWSER_PROFILE_DIR=".oracle-browser-profile"
BROWSER_HEADLESS="false"
BROWSER_CHANNEL="msedge"
BROWSER_EXECUTABLE_PATH=""
BROWSER_SESSION_CONNECT_MINUTES="20"
BROWSER_WORKER_INTERVAL_MINUTES="30"
PLAYWRIGHT_BROWSER_CHANNEL="msedge"
BROWSER_CDP_URL="http://127.0.0.1:9222"
BROWSER_CDP_LAUNCH="false"
EDGE_PROFILE_DIRECTORY="Default"
LOCAL_TICKET_STORE_PATH=".local-data/tickets.json"
